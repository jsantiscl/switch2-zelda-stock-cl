{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "switch2-zelda-stock-cl",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
